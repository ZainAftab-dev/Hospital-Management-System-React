{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "bash scripts/build-demo-db.sh",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "includeFiles": "{prisma/demo.db,dist/**}",
      "maxDuration": 30
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }]
}
