# Copy this file to .env.local for local development
# For Vercel deployment, set NEXT_PUBLIC_API_BASE_URL in Vercel dashboard → Settings → Environment Variables

# Local development (default - no need to set this locally)
# NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api

# For Vercel: set this to your hosted API URL, e.g.:
# NEXT_PUBLIC_API_BASE_URL=https://your-api-on-railway.up.railway.app/api
