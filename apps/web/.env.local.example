# Copy this file to .env.local for local development

# Local development (default - no need to set this locally)
# NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api

# Vercel (hosted demo): the API is its own Vercel project (apps/api), proxied through this app.
# NEXT_PUBLIC_API_BASE_URL=/api
# HMS_API_ORIGIN=https://<api-project>.vercel.app
